#!/bin/bash
# =================================================================================================================
# Logging Functions:
# -----------------------------------------------------------------------------------------------------------------
function debugMsg (){
  _msg="${@}"
  if [ "${BACKUP_LOG_LEVEL}" == "debug" ]; then
    echoGreen "$(date) - [DEBUG] - ${@}" >&2
  fi
}

function echoRed (){
  _msg="${@}"
  _red='\e[31m'
  _nc='\e[0m' # No Color
  echo -e "${_red}${_msg}${_nc}"
}

function echoYellow (){
  _msg="${@}"
  _yellow='\e[33m'
  _nc='\e[0m' # No Color
  echo -e "${_yellow}${_msg}${_nc}"
}

function echoBlue (){
  _msg="${@}"
  _blue='\e[34m'
  _nc='\e[0m' # No Color
  echo -e "${_blue}${_msg}${_nc}"
}

function echoGreen (){
  _msg="${@}"
  _green='\e[32m'
  _nc='\e[0m' # No Color
  echo -e "${_green}${_msg}${_nc}"
}

function echoMagenta (){
  _msg="${@}"
  _magenta='\e[35m'
  _nc='\e[0m' # No Color
  echo -e "${_magenta}${_msg}${_nc}"
}

function logInfo(){
  (
    infoMsg="${1}"
    echo -e "${infoMsg}"
    postMsgToWebhook "${ENVIRONMENT_FRIENDLY_NAME}" \
                     "${ENVIRONMENT_NAME}" \
                     "INFO" \
                     "${infoMsg}"
  )
}

function logWarn(){
  (
    warnMsg="${1}"
    echoYellow "${warnMsg}"
    postMsgToWebhook "${ENVIRONMENT_FRIENDLY_NAME}" \
                     "${ENVIRONMENT_NAME}" \
                     "WARN" \
                     "${warnMsg}"
  )
}

function logError(){
  (
    errorMsg="${1}"
    echoRed "[!!ERROR!!] - ${errorMsg}" >&2
    postMsgToWebhook "${ENVIRONMENT_FRIENDLY_NAME}" \
                     "${ENVIRONMENT_NAME}" \
                     "ERROR" \
                     "${errorMsg}"
    postMsgToPagerDuty "${errorMsg}"
  )
}

function postMsgToWebhook(){
  (
    if [ -z "${WEBHOOK_URL}" ]; then
      return 0
    fi

    projectFriendlyName=${1}
    projectName=${2}
    statusCode=${3}
    message=$(echo -e "${4}")
    local statusPrefix="[INFO]"
    local statusLabel="INFO"
    local statusIcon="🔵"
    local cardTitle="🔵 Database Backup - INFO"
    if [[ "${message}" == *"Successfully backed up "* ]]; then
      statusLabel="SUCCESS"
      statusIcon="✅"
      cardTitle="🟢 Database Backup - SUCCESS"
    fi
    if [ "${statusCode}" == "WARN" ]; then
      statusPrefix="[WARN]"
      statusLabel="WARNING"
      statusIcon="⚠️"
      cardTitle="🟠 Database Backup - WARNING"
    elif [ "${statusCode}" == "ERROR" ]; then
      statusPrefix="[ERROR]"
      statusLabel="ERROR"
      statusIcon="❌"
      cardTitle="🔴 Database Backup - FAILED"
    fi

    local environmentValue="Not set"
    if [ -n "${projectFriendlyName}" ]; then
      environmentValue="${projectFriendlyName}"
    fi

    local projectValue="Not set"
    if [ -n "${projectName}" ]; then
      projectValue="${projectName}"
    fi

    local messageValue="${statusPrefix} ${message}"

    local escEnvironmentValue
    local escProjectValue
    local escMessageValue
    local escStatusLabel
    local escStatusIcon
    local escCardTitle

    escEnvironmentValue=$(printf '%s' "${environmentValue}" | sed ':a;N;$!ba;s/\n/\\n/g; s/\\/\\\\/g; s/"/\\"/g')
    escProjectValue=$(printf '%s' "${projectValue}" | sed ':a;N;$!ba;s/\n/\\n/g; s/\\/\\\\/g; s/"/\\"/g')
    escMessageValue=$(printf '%s' "${messageValue}" | sed ':a;N;$!ba;s/\n/<br>/g; s/\\/\\\\/g; s/"/\\"/g')
    escStatusLabel=$(printf '%s' "${statusLabel}" | sed 's/\\/\\\\/g; s/"/\\"/g')
    escStatusIcon=$(printf '%s' "${statusIcon}" | sed 's/\\/\\\\/g; s/"/\\"/g')
    escCardTitle=$(printf '%s' "${cardTitle}" | sed 's/\\/\\\\/g; s/"/\\"/g')

    curl -s \
      -X POST \
      -H "Content-Type: application/json; charset=UTF-8" \
      -d "{
        \"cardsV2\": [
          {
            \"cardId\": \"backup-notification\",
            \"card\": {
              \"header\": {
                \"title\": \"${escCardTitle}\",
                \"subtitle\": \"Backup Container\"
              },
              \"sections\": [
                {
                  \"widgets\": [
                    {
                      \"textParagraph\": {
                        \"text\": \"<b>Environment:</b> ${escEnvironmentValue}\"
                      }
                    },
                    {
                      \"textParagraph\": {
                        \"text\": \"<b>Status:</b> ${escStatusIcon} ${escStatusLabel}\"
                      }
                    },
                    {
                      \"textParagraph\": {
                        \"text\": \"<b>Project:</b> ${escProjectValue}\"
                      }
                    },
                    {
                      \"textParagraph\": {
                        \"text\": \"<b>Message:</b> ${escMessageValue}\"
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }" \
      "${WEBHOOK_URL}" > /dev/null
  )
}

function postMsgToPagerDuty(){
  (
    if [ -z "${PGDUTY_SVC_KEY}" ]; then
      echo "Missing PagerDuty service key"
      return 0
    fi

    if [ -z "${PGDUTY_URL}" ]; then
      echo "Missing PagerDuty API url"
      return 0
    fi

    message=$(echo -e "${1}" | tr '\n' ' ')

    curl -s \
    -X POST \
    -H "Content-type: application/json" \
    -d "{
      \"service_key\": \"${PGDUTY_SVC_KEY}\",
      \"event_type\": \"trigger\",
      \"description\": \"${message}\"
    }" \
    "${PGDUTY_URL}" > /dev/null
  )
}
# =================================================================================================================
